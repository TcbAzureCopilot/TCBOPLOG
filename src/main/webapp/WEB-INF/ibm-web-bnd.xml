<?xml version="1.0" encoding="UTF-8"?>
<!-- WebSphere binding: maps the resource-ref in web.xml to the DataSource JNDI name on the server -->
<web-bnd xmlns="http://websphere.ibm.com/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://websphere.ibm.com/xml/ns/javaee http://websphere.ibm.com/xml/ns/javaee/ibm-web-bnd_1_2.xsd"
         version="1.2">
  <virtual-host name="default_host"/>
  <resource-ref name="jdbc/MachineRoomDS" binding-name="jdbc/MachineRoomDS"/>
</web-bnd>
